{
  "name": "epg-tools",
  "version": "0.3.0",
  "description": "Memory-efficient EPG toolkit: parallel grabbing with day-level caching and streaming XMLTV parsing, merging and serialization",
  "keywords": [
    "epg",
    "grabber",
    "guide",
    "iptv",
    "streaming",
    "xmltv"
  ],
  "homepage": "https://github.com/Ruby184/epg-tools#readme",
  "bugs": {
    "url": "https://github.com/Ruby184/epg-tools/issues"
  },
  "license": "MIT",
  "author": "ruby184",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ruby184/epg-tools.git"
  },
  "bin": {
    "epg": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cli/main.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./xmltv": {
      "types": "./dist/xmltv/main.d.ts",
      "import": "./dist/xmltv/main.js"
    },
    "./cache": {
      "types": "./dist/cache/main.d.ts",
      "import": "./dist/cache/main.js"
    },
    "./cache/sqlite": {
      "types": "./dist/cache/sqlite.d.ts",
      "import": "./dist/cache/sqlite.js"
    },
    "./grabber": {
      "types": "./dist/grabber/main.d.ts",
      "import": "./dist/grabber/main.js"
    },
    "./merge": {
      "types": "./dist/merge/main.d.ts",
      "import": "./dist/merge/main.js"
    },
    "./serve": {
      "types": "./dist/serve/main.d.ts",
      "import": "./dist/serve/main.js"
    },
    "./tv-grab": {
      "types": "./dist/tv-grab/main.d.ts",
      "import": "./dist/tv-grab/main.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "bench:memory": "npm run build && node bench/memory.mjs",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "ky": "^2.0.2",
    "p-queue": "^9.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@conventional-commits/parser": "^0.4.1",
    "@iptv/xmltv": "^1.0.1",
    "@types/node": "^26.2.0",
    "epg-parser": "^0.5.0",
    "fast-xml-parser": "^5.10.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.64.0",
    "oxlint": "^1.79.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs,json}": "oxfmt",
    "*.{ts,mts,cts,js,mjs,cjs}": "oxlint --fix"
  },
  "engines": {
    "node": ">=20.4"
  }
}
